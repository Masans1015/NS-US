      {
        "label": "認証情報（APIキー・パスワード・トークン）",
        "detect_patterns": ["sk-[A-Za-z0-9]{20,}", "(?i)password\\\\s*[:=]"],
        "rationale": "認証情報の外部送信は事故に直結",
        "source_document": "（記入）"
      }
